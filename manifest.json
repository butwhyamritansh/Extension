{
  "manifest_version": 3,
  "name": "Qwen-ChatGPT Bridge",
  "version": "1.0.0",
  "description": "Cross-context LLM synchronization — extract from Qwen, inject into ChatGPT, archive to PostgreSQL.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.qwen.ai/*"],
      "js": ["utils/constants.js", "utils/selectors.js", "utils/messaging.js", "content_scripts/qwen.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.chatgpt.com/*"],
      "js": ["utils/constants.js", "utils/selectors.js", "utils/messaging.js", "content_scripts/chatgpt.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.chatgpt.com/*",
    "*://*.qwen.ai/*",
    "http://localhost:3000/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
